# ========================================================
# ScholarMatch — Supabase & Vercel Environment Variables
# ========================================================
# Replace with your actual Supabase project credentials.
# Found in: Supabase Dashboard -> Project Settings -> API

# Public Project URL (Accessible on client and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Supabase Service Role Key (ONLY for backend scripts/migrations, NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Admin Email for dashboard authorization checks
ADMIN_EMAILS=admin@scholarmatch.gov.in,evaluator@college.edu
